# ---------- Frontend Environment Example ----------
# Copy this file to frontend/.env and adjust values if needed.
# All vars exposed to the browser MUST start with NEXT_PUBLIC_

# URL of the backend API (your docker-compose maps backend to localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: public app name shown in the UI
NEXT_PUBLIC_APP_NAME=Vinci Clips

# Optional: max upload size (MB) the UI should allow (keep in sync with backend if you change it)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500
